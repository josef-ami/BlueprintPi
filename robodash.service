[Unit]
Description=Blueprint obstacle-round dashboard (run, tune and calibrate)
# One process may hold the camera and the lidar at a time
Conflicts=robot.service
After=network.target

[Service]
Type=simple
User=suntzu
WorkingDirectory=/home/suntzu
Environment=PATH=/home/suntzu/env/bin:/usr/bin:/bin
ExecStart=/home/suntzu/env/bin/python /home/suntzu/dashboard.py
Restart=on-failure
RestartSec=3

# stdout/stderr land in the journal, not a manually managed log file
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
